<UserControl x:Class="VRCTimeline.Views.PhotoManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:VRCTimeline.Controls"
             xmlns:helpers="clr-namespace:VRCTimeline.Helpers"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!--
            写真の平坦リストを Group プロパティ（PhotoGroupDisplay 参照）でグループ化する。
            VirtualizingWrapPanel + ListBox.GroupStyle により、画面外のカードは ListBoxItem ごと破棄され、
            メモリ上には可視範囲分のビジュアルツリーしか残らない。
        -->
        <CollectionViewSource x:Key="PhotosViewSource" Source="{Binding Photos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <controls:FilterBarControl Grid.Row="0"
            FilterDateFrom="{Binding FilterDateFrom}"
            FilterDateTo="{Binding FilterDateTo}"
            PlayerFilterText="{Binding PlayerFilter}"
            WorldFilterText="{Binding WorldFilter}"
            SearchCommand="{Binding LoadPhotosCommand}" />

        <!-- Status + multi-select command bar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- 複数選択時の一括修正コマンドバー（右寄せ） -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasFixableSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding MultiSelectStatus}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Photo_FixUnknown_Button}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding FixSelectedUnknownPhotosCommand}"
                        Padding="10,2" Height="30" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Opacity="0.6" Margin="0,0,16,0"
                           VerticalAlignment="Center" />
                <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,5,0"
                                          Opacity="0.5" />
                <TextBlock Text="{Binding DateRangeText}" Opacity="0.5" FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Photo Detail Panel (always visible) -->
        <materialDesign:Card Grid.Row="2" Padding="16" Margin="0,0,0,12"
                              materialDesign:ElevationAssist.Elevation="Dp3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top"
                            Margin="24,0,0,0">
                    <Button Content="{DynamicResource Photo_ShowActivity}" Command="{Binding ShowActivityForVisitCommand}"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            IsEnabled="{Binding IsPhotoSelected}"
                            Margin="0,0,0,6" />
                    <Button Content="{DynamicResource Photo_OpenPhoto}" Command="{Binding OpenSelectedPhotoCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            IsEnabled="{Binding IsPhotoSelected}"
                            Margin="0,0,0,6" />
                    <Button Content="{DynamicResource Photo_OpenFolder}" Command="{Binding OpenPhotoFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            IsEnabled="{Binding IsPhotoSelected}" />
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Photo_JoinedPlayers}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                    Visibility="{Binding HasPlayerContext, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="Earth" Width="18" Height="18"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Opacity="0.7" />
                            <TextBlock Text="{Binding SelectedPhotoWorldName}" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="13" />
                            <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="16" Height="16"
                                                      VerticalAlignment="Center" Margin="20,0,6,0"
                                                      Opacity="0.6" />
                            <TextBlock Text="{Binding SelectedPhotoTimeRange}" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                    Visibility="{Binding HasPlayerSummary, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                            <TextBlock Text="{Binding PlayerFilter}" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="13" Margin="0,0,16,0" />
                            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12">
                                <Run Text="{DynamicResource Activity_EncounterCount}" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <Run Text="{Binding PlayerEncounterCount, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12">
                                <Run Text="{DynamicResource Activity_TotalTime}" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <Run Text="{Binding PlayerTotalTime, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="PlayerScrollViewer" Height="75"
                                  VerticalAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedPhotoPlayers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="10,6" Margin="4" Cursor="Hand"
                                                          materialDesign:ElevationAssist.Elevation="Dp1">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SearchByPlayerCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding TimeRange}" FontSize="11"
                                                       Opacity="0.6" />
                                        </StackPanel>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Thumb Grid.Row="2" x:Name="PlayerResizeThumb" Height="6" Cursor="SizeNS"
                           DragDelta="PlayerResizeThumb_DragDelta"
                           Opacity="0.4">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Height="2" Width="40"
                                            Background="{DynamicResource MaterialDesignBody}"
                                            CornerRadius="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Opacity="0.4" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </DockPanel>
        </materialDesign:Card>

        <!-- No Photos Message -->
        <TextBlock Grid.Row="3" Text="{DynamicResource Photo_NoPhotos}"
                   Visibility="{Binding HasNoPhotos, Converter={StaticResource BoolToVis}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Opacity="0.5" />

        <!--
            Photo Gallery (virtualized).
            ListBox + CollectionViewSource (group by PhotoDisplayItem.Group) + VirtualizingWrapPanel で、
            可視範囲外のカードはコンテナごと破棄される。
            グループヘッダーは GroupStyle.HeaderTemplate で表示する（DataContext は CollectionViewGroup）。
            外側に ScrollViewer を巻かないこと: 巻くと内側 ListBox に無限高が伝播し全アイテムが実体化される。
        -->
        <!--
            アイテム単位スクロール（CanContentScroll=True）。
            ピクセルスクロール + IsVirtualizingWhenGrouping=True の組み合わせは VirtualizingWrapPanel で
            全アイテム測定を誘発しフリーズに繋がる（グループの pixel offset を確定するため）。
            アイテム単位スクロールでは 1 ティック=既定 3 アイテムしか動かないため、
            PreviewMouseWheel ハンドラで複数アイテム分まとめてスクロールして体感速度を補う。
        -->
        <ListBox x:Name="PhotoListBox" Grid.Row="3"
                 Visibility="{Binding HasNoPhotos, Converter={StaticResource InverseBoolToVis}}"
                 ItemsSource="{Binding Source={StaticResource PhotosViewSource}}"
                 SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
                 SelectionMode="Extended"
                 helpers:MultiSelectBehavior.BindableSelectedItems="{Binding SelectedPhotos}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.CacheLength="1,2"
                 VirtualizingPanel.CacheLengthUnit="Page"
                 PreviewMouseWheel="PhotoListBox_PreviewMouseWheel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <!-- ContextMenu は別ビジュアルツリー(Popup)のため、ListBoxItem の Tag に VM を載せて
                         PlacementTarget.Tag 経由でコマンドへ到達する。CommandParameter は
                         PlacementTarget.DataContext = 右クリックした写真の PhotoDisplayItem。 -->
                    <Setter Property="Tag"
                            Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Ctx_CopyWorldUrl}"
                                          Command="{Binding PlacementTarget.Tag.CopyWorldUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasWorldId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource Ctx_OpenWorldInBrowser}"
                                          Command="{Binding PlacementTarget.Tag.OpenWorldInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasWorldId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Ctx_CopyInstanceUrl}"
                                          Command="{Binding PlacementTarget.Tag.CopyInstanceUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasInstanceId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{DynamicResource Ctx_OpenInstanceInBrowser}"
                                          Command="{Binding PlacementTarget.Tag.OpenInstanceInBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasInstanceId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Ctx_CopyWorldName}"
                                          Command="{Binding PlacementTarget.Tag.CopyWorldNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasWorldName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Activity_Rejoin}"
                                          Command="{Binding PlacementTarget.Tag.RejoinInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.HasInstanceId, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <!-- DataContext = CollectionViewGroup; Name = PhotoGroupDisplay インスタンス -->
                            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                    CornerRadius="4" Padding="12,6" Margin="0,8,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Earth" Width="18" Height="18"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              Opacity="0.7" />
                                    <TextBlock Text="{Binding Name.HeaderDisplay}" FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="15" Height="15"
                                                              VerticalAlignment="Center" Margin="20,0,6,0"
                                                              Opacity="0.5" />
                                    <TextBlock Text="{Binding Name.HeaderTimeRange}" FontSize="12"
                                               VerticalAlignment="Center" Opacity="0.6" />
                                    <!-- 「不明」グループ＋自分で編集した手動データに編集（鉛筆）ボタンを表示 -->
                                    <Button Margin="10,0,0,0" Padding="0" Width="26" Height="26"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="{DynamicResource Photo_FixEdit_Title}"
                                            Visibility="{Binding Name.IsEditable, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.FixGroupCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <materialDesign:Card Width="224" Margin="6"
                                        Padding="0"
                                        UniformCornerRadius="0"
                                        Cursor="Hand"
                                        UseLayoutRounding="True">
                        <materialDesign:Card.Style>
                            <Style TargetType="materialDesign:Card">
                                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Opacity" Value="0.95" />
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:Card.Style>

                        <materialDesign:Card.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                        Command="{Binding DataContext.OpenPhotoFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                        </materialDesign:Card.InputBindings>
                        <Grid>
                            <StackPanel>
                                <Border Height="126"
                                        Background="#2A2A2A"
                                        ClipToBounds="True">
                                    <Image Source="{Binding FilePath, Converter={StaticResource PathToThumb}, IsAsync=True}"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="10,6,10,8">
                                    <TextBlock Text="{Binding TakenAtDisplay}"
                                            FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <Border IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
